diff --git a/dm/host/cheat.c b/dm/host/cheat.c
new file mode 100644
index 0000000..029006e
--- /dev/null
+++ b/dm/host/cheat.c
@@ -0,0 +1,130 @@
+// Cheats (Atmosphère format): <cheats dir>/<first 8 bytes of main's build ID>.txt holds the codes, <cheats dir>/toggles.txt the ones that are on, one "[name]" a line
+// (DM_CHEATS_DIR, files/cheats in the app; the cheat menu writes toggles.txt). The game's memory is this process's memory, so the cheat VM (cheat_vm.c) writes it directly.
+//  * dm_cheat_static_patches: for loader.c, before the code is sealed: the code stores ("0" opcodes, main region) of the cheats that are on, for cheats that are only such stores.
+//    Code in main is read-only afterwards, so these are patches like a .pchtxt's and take effect from the next start.
+//  * dm_cheat_start: a thread that runs the enabled cheats about 60 times a second (heap, register, key and data stores). It follows toggles.txt while playing.
+// Reads and writes are checked against the regions the engine knows (main's image, the opened heap): an address outside them is dropped, so a stray code cannot crash the game.
+#include "dm.h"
+#include "cheat_vm.h"
+#include <pthread.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+int dm_guest_region(int type, uint64_t *base, size_t *size);   // hle_svc.c
+uint64_t dm_input_held(void);                                   // hle_hid.c
+
+static module_t *main_mod(void) { for (int i = 0; i < g_nmod; i++) if (!strcmp(g_mod[i].name, "main")) return &g_mod[i]; return NULL; }
+static int cheat_path(char *out, size_t n, const char *file) { const char *d = getenv("DM_CHEATS_DIR"); if (!d || !*d) return 0; snprintf(out, n, "%s/%s", d, file); return 1; }
+// bid: main's build ID; NULL = look main up (the loader asks while main is still being mapped, before it is in g_mod)
+static int cheat_file(char *out, size_t n, const char *bid) {
+    if (!bid) { module_t *m = main_mod(); bid = m ? m->build_id : ""; } if (!bid[0]) return 0;
+    char f[64]; snprintf(f, sizeof f, "%.16s.txt", bid);
+    if (!cheat_path(out, n, f)) return 0;
+    struct stat st; if (!stat(out, &st)) return 1;
+    for (char *c = f; *c; c++) if (*c >= 'a' && *c <= 'f') *c -= 32;     // the file may be named in capitals
+    snprintf(f + 16, sizeof f - 16, ".txt"); if (!cheat_path(out, n, f)) return 0;
+    return !stat(out, &st);
+}
+// toggles.txt: the names in [ ] that are on
+static int toggles(char (**names)[CHEAT_NAME_MAX]) {
+    char p[1200]; *names = NULL; if (!cheat_path(p, sizeof p, "toggles.txt")) return 0;
+    FILE *f = fopen(p, "r"); if (!f) return 0;
+    int n = 0, cap = 0; char ln[512];
+    while (fgets(ln, sizeof ln, f)) {
+        char *t = ln; while (*t == ' ' || *t == '\t') t++; if (*t != '[') continue; char *e = strrchr(t, ']'); if (!e) continue; *e = 0;
+        if (n == cap) { cap = cap ? cap * 2 : 32; *names = realloc(*names, cap * sizeof **names); if (!*names) { fclose(f); return 0; } }
+        snprintf((*names)[n++], CHEAT_NAME_MAX, "%s", t + 1);
+    }
+    fclose(f); return n;
+}
+static int is_on(char (*on)[CHEAT_NAME_MAX], int non, const char *name) { for (int i = 0; i < non; i++) if (!strcmp(on[i], name)) return 1; return 0; }
+
+int dm_cheat_static_patches(const char *bid, dm_cheat_patch **out) {
+    *out = NULL;
+    char p[1200]; if (!cheat_file(p, sizeof p, bid)) return 0;
+    cheat_t *c; int nc = cheat_parse(p, &c); if (!nc) return 0;
+    char (*on)[CHEAT_NAME_MAX]; int non = toggles(&on); int any = 0; for (int i = 0; i < nc; i++) if (!c[i].master && is_on(on, non, c[i].name)) any = 1;
+    dm_cheat_patch *v = NULL; int nv = 0;
+    for (int i = 0; any && i < nc; i++) {
+        if (!(c[i].master || is_on(on, non, c[i].name)) || c[i].why[0] || !c[i].flat) continue;
+        for (int k = 0; k < c[i].n; ) {
+            uint32_t w = c[i].code[k]; int T = (w >> 24) & 0xF, len = T == 8 ? 4 : 3;
+            if (((w >> 20) & 0xF) == 0 && ((w >> 16) & 0xF) == 0) {     // main region, no offset register
+                v = realloc(v, (nv + 1) * sizeof *v); if (!v) break;
+                dm_cheat_patch *q = &v[nv++]; q->off = (uint64_t)(w & 0xFF) << 32 | c[i].code[k + 1]; q->n = T;
+                uint64_t val = T == 8 ? (uint64_t)c[i].code[k + 2] << 32 | c[i].code[k + 3] : c[i].code[k + 2]; memcpy(q->b, &val, 8);
+            }
+            k += len;
+        }
+    }
+    cheat_free(c, nc); free(on); *out = v; return nv;
+}
+
+// ---- the runtime ----
+static int env_region(void *u, int t, uint64_t *b) {
+    (void)u; if (t == 0) { module_t *m = main_mod(); if (!m || !m->base) return 0; *b = (uint64_t)(uintptr_t)m->base; return 1; }
+    size_t sz; return dm_guest_region(t, b, &sz);
+}
+static int in_heap(uint64_t a, int n) { uint64_t b; size_t sz; return dm_guest_region(1, &b, &sz) && a >= b && (uint64_t)n <= sz && a - b <= sz - (uint64_t)n; }
+static int in_main(uint64_t a, int n, int write) {
+    module_t *m = main_mod(); if (!m || !m->base) return 0;
+    uint64_t b = (uint64_t)(uintptr_t)m->base, lo = write ? ((m->text_end + 0x3FFF) & ~0x3FFFull) : 0, hi = m->key_page_off ? m->key_page_off : m->size;   // writes: after the sealed code, before the key page
+    return a >= b + lo && a + (uint64_t)n <= b + hi && a + (uint64_t)n > a;
+}
+// What the engine did, for the log (a cheat that "does nothing" is usually an address outside the regions, or a condition that is never true)
+static unsigned long st_wr_ok, st_wr_drop, st_rd_ok, st_rd_drop; static uint64_t st_drop_wr[6], st_drop_rd[6];
+static int env_rd(void *u, uint64_t a, void *buf, int n) {
+    (void)u; if (!in_heap(a, n) && !in_main(a, n, 0)) { if (st_rd_drop < 6) st_drop_rd[st_rd_drop] = a; st_rd_drop++; return 1; }
+    memcpy(buf, (void *)(uintptr_t)a, n); st_rd_ok++; return 0;
+}
+static int env_wr(void *u, uint64_t a, const void *buf, int n) {
+    (void)u; if (!in_heap(a, n) && !in_main(a, n, 1)) { if (st_wr_drop < 6) st_drop_wr[st_wr_drop] = a; st_wr_drop++; return 1; }
+    memcpy((void *)(uintptr_t)a, buf, n); st_wr_ok++; return 0;
+}
+static void report(int np) {   // every 5 s while something changed
+    static unsigned long l_wo, l_wd, l_ro, l_rd; if (st_wr_ok == l_wo && st_wr_drop == l_wd && st_rd_ok == l_ro && st_rd_drop == l_rd) return;
+    l_wo = st_wr_ok; l_wd = st_wr_drop; l_ro = st_rd_ok; l_rd = st_rd_drop;
+    uint64_t hb = 0; size_t hs = 0; dm_guest_region(1, &hb, &hs); module_t *m = main_mod();
+    LOG("cheats: %d words | main %p size %#zx writable %#llx-%#llx | heap %#llx +%#zx | writes ok %lu dropped %lu | reads ok %lu dropped %lu", np,
+        m ? (void *)m->base : NULL, m ? (size_t)m->size : 0, m ? (unsigned long long)((m->text_end + 0x3FFF) & ~0x3FFFull) : 0, m ? (unsigned long long)(m->key_page_off ? m->key_page_off : m->size) : 0,
+        (unsigned long long)hb, hs, st_wr_ok, st_wr_drop, st_rd_ok, st_rd_drop);
+    for (int i = 0; i < 6 && i < (int)st_wr_drop; i++) LOG("cheats:   dropped write at %#llx (main+%#llx, heap+%#llx)", (unsigned long long)st_drop_wr[i], (unsigned long long)(m ? st_drop_wr[i] - (uint64_t)(uintptr_t)m->base : 0), (unsigned long long)(st_drop_wr[i] - hb));
+    for (int i = 0; i < 6 && i < (int)st_rd_drop; i++) LOG("cheats:   dropped read at %#llx (main+%#llx, heap+%#llx)", (unsigned long long)st_drop_rd[i], (unsigned long long)(m ? st_drop_rd[i] - (uint64_t)(uintptr_t)m->base : 0), (unsigned long long)(st_drop_rd[i] - hb));
+}
+static uint64_t env_keys(void *u) { (void)u; return dm_input_held(); }
+
+static uint32_t *build(cheat_t *c, int nc, int *nout) {   // masters first, then the cheats that are on, when any is
+    char (*on)[CHEAT_NAME_MAX]; int non = toggles(&on), any = 0, total = 0; uint32_t *p = NULL; *nout = 0;
+    for (int i = 0; i < nc; i++) if (!c[i].master && !c[i].why[0] && is_on(on, non, c[i].name)) any = 1;
+    for (int pass = 0; any && pass < 2; pass++)
+        for (int i = 0; i < nc; i++) {
+            if (c[i].why[0] || !c[i].n || (c[i].master != (pass == 0))) continue;
+            if (!c[i].master && !is_on(on, non, c[i].name)) continue;
+            p = realloc(p, (total + c[i].n) * sizeof *p); if (!p) { free(on); return NULL; }
+            memcpy(p + total, c[i].code, c[i].n * sizeof *p); total += c[i].n;
+        }
+    free(on); *nout = total; return p;
+}
+static uint64_t stamp(const char *p) { struct stat st; return stat(p, &st) ? 0 : ((uint64_t)st.st_mtim.tv_sec * 1000000000ull + (uint64_t)st.st_mtim.tv_nsec) ^ ((uint64_t)st.st_size << 40) ^ 1; }
+static void *cheat_main(void *arg) {
+    (void)arg; char path[1200], tp[1200];
+    cheat_t *c = NULL; int nc = 0, tick = 0, np = 0; uint64_t fm = 0, tm = ~0ull; uint32_t *prog = NULL;
+    static const cheat_env env = { NULL, env_region, env_rd, env_wr, env_keys };
+    for (;; tick++, usleep(16000)) {
+        if (tick % 20 == 0) {   // about every 0.3 s: the cheat file and the toggles may change while playing (import, the menu)
+            if (cheat_file(path, sizeof path, NULL) && stamp(path) != fm) {
+                cheat_free(c, nc); fm = stamp(path); nc = cheat_parse(path, &c); tm = ~0ull;
+                int bad = 0; for (int i = 0; i < nc; i++) if (c[i].why[0]) { bad++; LOG("cheats: [%s] left out: %s", c[i].name, c[i].why); }
+                LOG("cheats: %d in %s, %d cannot run", nc, path, bad);
+            }
+            uint64_t t = cheat_path(tp, sizeof tp, "toggles.txt") ? stamp(tp) : 0;
+            if (t != tm) { tm = t; free(prog); prog = build(c, nc, &np); LOG("cheats: %d code words on", np); }
+        }
+        if (np) { cheat_run(prog, np, &env); if (tick % 300 == 299) report(np); }
+    }
+    return NULL;
+}
+void dm_cheat_start(void) {
+    const char *d = getenv("DM_CHEATS_DIR"); if (!d || !*d) return;
+    pthread_t th; if (!pthread_create(&th, NULL, cheat_main, NULL)) { pthread_detach(th); LOG("cheats: engine started (%s)", d); }
+}
diff --git a/dm/host/cheat_vm.c b/dm/host/cheat_vm.c
new file mode 100644
index 0000000..3256403
--- /dev/null
+++ b/dm/host/cheat_vm.c
@@ -0,0 +1,135 @@
+// See cheat_vm.h. The semantics follow Atmosphère's dmnt cheat VM (libexosphere-independent reimplementation from its public code-type documentation).
+#include "cheat_vm.h"
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int hexw(const char *s, uint32_t *out) {
+    uint32_t v = 0; for (int i = 0; i < 8; i++) { char c = s[i]; int d = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1; if (d < 0) return 0; v = v << 4 | (uint32_t)d; }
+    *out = v; return 1;
+}
+static void why_set(char *w, size_t n, const char *s) { if (w && n) snprintf(w, n, "%s", s); }
+
+int cheat_oplen(const uint32_t *c, int i, int n, char *why, size_t wsz) {
+    uint32_t w = c[i]; int t = w >> 28, T = (w >> 24) & 0xF, len;
+    switch (t) {
+    case 0: case 1: if (T != 1 && T != 2 && T != 4 && T != 8) { why_set(why, wsz, "bad width"); return 0; } len = T == 8 ? 4 : 3; break;
+    case 2: len = 1; break;
+    case 3: len = ((w >> 24) & 0xF) == 0 ? 2 : 1; if (((w >> 24) & 0xF) > 1) { why_set(why, wsz, "loop"); return 0; } break;
+    case 4: len = 3; break;
+    case 5: case 6: if (T != 1 && T != 2 && T != 4 && T != 8) { why_set(why, wsz, "bad width"); return 0; } len = t == 5 ? 2 : 3; break;
+    case 7: if (T != 1 && T != 2 && T != 4 && T != 8) { why_set(why, wsz, "bad width"); return 0; } len = T == 8 ? 3 : 2; break;
+    case 8: len = 1; break;
+    case 9: if (T != 1 && T != 2 && T != 4 && T != 8) { why_set(why, wsz, "bad width"); return 0; } len = (w >> 8 & 0xF) ? (T == 8 ? 3 : 2) : 1; break;
+    case 0xA: if (T != 1 && T != 2 && T != 4 && T != 8) { why_set(why, wsz, "bad width"); return 0; } { int o = w >> 8 & 0xF; if (o > 5) { why_set(why, wsz, "store offset type"); return 0; } len = (o == 2 || o == 3 || o == 5) ? 2 : 1; } break;
+    case 0xC: { int sub = (w >> 24) & 0xF;
+        if (sub != 0) { why_set(why, wsz, "code type C1+ (save/restore registers etc.)"); return 0; }
+        int X = (w >> 8) & 0xF, W = (w >> 20) & 0xF; if (W != 1 && W != 2 && W != 4 && W != 8) { why_set(why, wsz, "bad width"); return 0; }
+        if (X == 4) len = W == 8 ? 3 : 2; else if (X == 5) len = 1; else { why_set(why, wsz, "C0 operand type"); return 0; } break; }
+    default: { char b[40]; snprintf(b, sizeof b, "code type %X", t); why_set(why, wsz, b); return 0; }
+    }
+    if (i + len > n) { why_set(why, wsz, "truncated code"); return 0; }
+    return len;
+}
+
+int cheat_parse(const char *path, cheat_t **out) {
+    *out = NULL; FILE *f = fopen(path, "r"); if (!f) return 0;
+    cheat_t *v = NULL; int nv = 0, cap = 0, cur = -1; char ln[1024], first = 1;
+    while (fgets(ln, sizeof ln, f)) {
+        char *t = ln; if (first && (uint8_t)t[0] == 0xef && (uint8_t)t[1] == 0xbb && (uint8_t)t[2] == 0xbf) t += 3; first = 0;
+        while (isspace((unsigned char)*t)) t++;
+        size_t l = strlen(t); while (l && isspace((unsigned char)t[l - 1])) t[--l] = 0;
+        if (!*t) continue;
+        if (*t == '[' || *t == '{') {
+            char close = *t == '[' ? ']' : '}'; char *e = strrchr(t, close); if (!e) continue; *e = 0;
+            if (nv == cap) { cap = cap ? cap * 2 : 64; v = realloc(v, cap * sizeof *v); if (!v) { fclose(f); return 0; } }
+            cheat_t *c = &v[nv]; memset(c, 0, sizeof *c); c->master = close == '}';
+            char *nm = t + 1; while (isspace((unsigned char)*nm)) nm++; size_t nl = strlen(nm); while (nl && isspace((unsigned char)nm[nl - 1])) nm[--nl] = 0;
+            snprintf(c->name, sizeof c->name, "%s", nm); cur = nv++; continue;
+        }
+        if (cur < 0) continue;
+        cheat_t *c = &v[cur]; uint32_t w; int bad = 0; const char *p = t; uint32_t tmp[16]; int nt = 0;
+        while (*p) { while (isspace((unsigned char)*p)) p++; if (!*p) break; if (nt >= 16 || !hexw(p, &tmp[nt])) { bad = 1; break; } nt++; p += 8; if (*p && !isspace((unsigned char)*p)) { bad = 1; break; } }
+        (void)w; if (bad) { snprintf(c->why, sizeof c->why, "unreadable line"); continue; }
+        c->code = realloc(c->code, (c->n + nt) * sizeof *c->code); if (!c->code) { fclose(f); return 0; }
+        memcpy(c->code + c->n, tmp, nt * sizeof *tmp); c->n += nt;
+    }
+    fclose(f);
+    for (int k = 0; k < nv; k++) { cheat_t *c = &v[k]; if (c->why[0]) continue; int i = 0; c->flat = c->n > 0;
+        while (i < c->n) { int len = cheat_oplen(c->code, i, c->n, c->why, sizeof c->why); if (!len) break; if (c->code[i] >> 28) c->flat = 0; i += len; }
+        if (c->why[0]) c->flat = 0; }
+    *out = v; return nv;
+}
+void cheat_free(cheat_t *c, int n) { for (int i = 0; i < n; i++) free(c[i].code); free(c); }
+
+#define MAXSTEPS 200000
+static uint64_t mask(int T) { return T >= 8 ? ~0ull : (1ull << (T * 8)) - 1; }
+static uint64_t imm64(const uint32_t *c, int T) { return T == 8 ? ((uint64_t)c[0] << 32 | c[1]) : c[0]; }
+static int is_open(uint32_t w) { int t = w >> 28; return t == 1 || t == 8 || (t == 0xC && ((w >> 24) & 0xF) == 0); }
+// from c[i] (just after a failed condition's opcode) to after its End, or, with stop_else, after its Else when it has one
+static int skip(const uint32_t *c, int i, int n, int stop_else) {
+    int depth = 1;
+    while (i < n) { uint32_t w = c[i]; int len = cheat_oplen(c, i, n, NULL, 0); if (!len) return n;
+        if (is_open(w)) depth++;
+        else if (w >> 28 == 2) { int e = (w >> 24) & 0xF; if (e == 1 && depth == 1 && stop_else) return i + len; if (e == 0 && --depth == 0) return i + len; }
+        i += len; }
+    return n;
+}
+static int cond(int c, uint64_t a, uint64_t b) { switch (c) { case 1: return a > b; case 2: return a >= b; case 3: return a < b; case 4: return a <= b; case 5: return a == b; case 6: return a != b; } return 0; }
+static uint64_t calc(int op, uint64_t a, uint64_t b) {
+    switch (op) { case 0: return a + b; case 1: return a - b; case 2: return a * b; case 3: return b < 64 ? a << b : 0; case 4: return b < 64 ? a >> b : 0; case 5: return a & b; case 6: return a | b; case 7: return ~a; case 8: return a ^ b; case 9: return a; }
+    return a;
+}
+static uint64_t base_of(const cheat_env *e, int m) { uint64_t b = 0; if (m < 0 || m > 3 || !e->region(e->u, m, &b)) return 0; return b; }
+static int mem_rd(const cheat_env *e, uint64_t a, int T, uint64_t *v) { uint8_t b[8] = {0}; if (e->rd(e->u, a, b, T)) return 1; uint64_t x = 0; memcpy(&x, b, T); *v = x; return 0; }
+static void mem_wr(const cheat_env *e, uint64_t a, int T, uint64_t v) { uint8_t b[8]; memcpy(b, &v, 8); (void)e->wr(e->u, a, b, T); }
+
+int cheat_run(const uint32_t *c, int n, const cheat_env *env) {
+    uint64_t reg[16] = {0}; int loop_top[16]; for (int i = 0; i < 16; i++) loop_top[i] = -1;
+    int i = 0, steps = 0;
+    while (i < n && steps++ < MAXSTEPS) {
+        uint32_t w = c[i]; int len = cheat_oplen(c, i, n, NULL, 0); if (!len) break;
+        int t = w >> 28, T = (w >> 24) & 0xF; const uint32_t *a = c + i;
+        switch (t) {
+        case 0: {   // 0TMR00AA AAAAAAAA VVVVVVVV (VVVVVVVV)
+            int M = (w >> 20) & 0xF, R = (w >> 16) & 0xF; uint64_t base = base_of(env, M); if (!base) break;
+            uint64_t addr = base + (((uint64_t)(w & 0xFF) << 32 | a[1])) + reg[R];
+            mem_wr(env, addr, T, imm64(a + 2, T) & mask(T)); break; }
+        case 1: {   // 1TMC00AA AAAAAAAA VVVVVVVV (VVVVVVVV)
+            int M = (w >> 20) & 0xF, C = (w >> 16) & 0xF; uint64_t base = base_of(env, M), v, ok = 0;
+            if (base && !mem_rd(env, base + ((uint64_t)(w & 0xFF) << 32 | a[1]), T, &v)) ok = cond(C, v, imm64(a + 2, T) & mask(T));
+            if (!ok) { i = skip(c, i + len, n, 1); continue; } break; }
+        case 2: if (((w >> 24) & 0xF) == 1) { i = skip(c, i + len, n, 0); continue; } break;   // Else reached by the true branch: skip its else part
+        case 3: { int R = (w >> 16) & 0xF;
+            if (T == 0) { reg[R] = a[1]; loop_top[R] = i + len; }
+            else if (loop_top[R] >= 0) { if (reg[R] > 0) { reg[R]--; i = loop_top[R]; continue; } loop_top[R] = -1; }
+            break; }
+        case 4: reg[(w >> 16) & 0xF] = (uint64_t)a[1] << 32 | a[2]; break;
+        case 5: {   // 5TMRI0AA AAAAAAAA
+            int M = (w >> 20) & 0xF, R = (w >> 16) & 0xF, fromreg = ((w >> 12) & 0xF) != 0; uint64_t rel = (uint64_t)(w & 0xFF) << 32 | a[1], v, addr;
+            if (fromreg) addr = reg[R] + rel; else { uint64_t b = base_of(env, M); if (!b) break; addr = b + rel; }
+            if (!mem_rd(env, addr, T, &v)) { reg[R] = v; } break; }
+        case 6: {   // 6T0RIor0 VVVVVVVV VVVVVVVV
+            int R = (w >> 16) & 0xF, inc = (w >> 12) & 0xF, o = (w >> 8) & 0xF, r = (w >> 4) & 0xF; uint64_t addr = reg[R] + (o ? reg[r] : 0);
+            mem_wr(env, addr, T, ((uint64_t)a[1] << 32 | a[2]) & mask(T)); if (inc) reg[R] += T; break; }
+        case 7: {   // 7T0RC000 VVVVVVVV (VVVVVVVV)
+            int R = (w >> 16) & 0xF, C = (w >> 12) & 0xF; uint64_t v = imm64(a + 1, T);
+            if (C < 5) { reg[R] = calc(C, reg[R], v) & mask(T); } break; }
+        case 8: { uint64_t k = env->keys ? env->keys(env->u) : 0, m = w & 0x0FFFFFFF; if ((k & m) != m) { i = skip(c, i + len, n, 1); continue; } break; }
+        case 9: {   // 9TCRS0s0 VVVVVVVV (VVVVVVVV)
+            int C = (w >> 20) & 0xF, R = (w >> 16) & 0xF, S = (w >> 12) & 0xF, imm = (w >> 8) & 0xF, s = (w >> 4) & 0xF;
+            uint64_t b = imm ? imm64(a + 1, T) : reg[s]; reg[R] = calc(C, reg[S], b) & mask(T); break; }
+        case 0xA: {   // ATSRIOxa (aaaaaaaa)
+            int S = (w >> 20) & 0xF, R = (w >> 16) & 0xF, inc = (w >> 12) & 0xF, o = (w >> 8) & 0xF, x = (w >> 4) & 0xF; uint64_t imm = len == 2 ? ((uint64_t)(w & 0xF) << 32 | a[1]) : 0, addr;
+            switch (o) { case 0: addr = reg[R]; break; case 1: addr = reg[R] + reg[x]; break; case 2: addr = reg[R] + imm; break;
+                         case 3: addr = base_of(env, x) + imm; break; case 4: addr = base_of(env, x) + reg[R]; break; default: addr = base_of(env, x) + reg[R] + imm; }
+            mem_wr(env, addr, T, reg[S] & mask(T)); if (inc && o < 3) reg[R] += T; break; }
+        case 0xC: {   // C0TcSX## : compare register S with an immediate (X=4) or another register (X=5)
+            int W = (w >> 20) & 0xF, C = (w >> 16) & 0xF, S = (w >> 12) & 0xF, X = (w >> 8) & 0xF, R2 = (w >> 4) & 0xF;
+            uint64_t b = X == 4 ? imm64(a + 1, W) : reg[R2]; if (!cond(C, reg[S] & mask(W), b & mask(W))) { i = skip(c, i + len, n, 1); continue; } break; }
+        }
+        i += len;
+    }
+    return steps;
+}
diff --git a/dm/host/cheat_vm.h b/dm/host/cheat_vm.h
new file mode 100644
index 0000000..1ef3fd2
--- /dev/null
+++ b/dm/host/cheat_vm.h
@@ -0,0 +1,36 @@
+// Atmosphère-format cheat codes: the file parser and the code interpreter (the cheat VM of Atmosphère's dmnt, the opcodes cheat files use). No game or host state in here:
+// memory, the region bases and the controller go through cheat_env, so the interpreter runs the same in the app (cheat.c) and in a unit test (tests/t_cheat.c).
+// Supported: 0 store static, 1 conditional (memory), 2 end / else, 3 loop, 4 load register (immediate), 5 load register (memory), 6 store to a register's address,
+// 7 legacy arithmetic, 8 key conditional, 9 register arithmetic, A store register to memory, C0 register conditional (immediate / register operand).
+// A code with any other opcode (C1-C4 save/restore, D, B, FFx ...) makes its cheat "unsupported": cheat_validate says so and the cheat is left out.
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+#define CHEAT_NAME_MAX 96
+typedef struct {
+    char name[CHEAT_NAME_MAX];
+    int master;           // {name}: always on
+    uint32_t *code; int n;
+    char why[80];         // empty when every opcode is supported, else the first one that is not
+    int flat;             // only "0" (store static) opcodes: no condition, loop or register is involved
+} cheat_t;
+
+typedef struct {
+    void *u;
+    int (*region)(void *u, int type, uint64_t *base);              // 0 main, 1 heap, 2 alias, 3 aslr: its base address; 0 = not available yet
+    int (*rd)(void *u, uint64_t a, void *buf, int n);              // 0 = ok, else the address cannot be read
+    int (*wr)(void *u, uint64_t a, const void *buf, int n);        // 0 = ok, else the address cannot be written (the write is dropped)
+    uint64_t (*keys)(void *u);                                     // buttons held now (nn::hid::NpadButton bits)
+} cheat_env;
+
+// Parse a cheat file ("[name]" / "{master}" headers, then lines of 8-digit hex words). Returns the number of cheats (0 if the file cannot be read); free with cheat_free
+int cheat_parse(const char *path, cheat_t **out);
+void cheat_free(cheat_t *c, int n);
+// Length in words of the opcode at c[i] (0 when it is not one this interpreter runs; why gets the reason)
+int cheat_oplen(const uint32_t *c, int i, int n, char *why, size_t whysz);
+// Runs a whole program (cheats' code joined in file order) once with zeroed registers. Returns the number of opcodes executed
+int cheat_run(const uint32_t *code, int n, const cheat_env *env);
+
+// One store the loader makes into main's image before the code is sealed (cheat.c dm_cheat_static_patches): offset in main, n bytes (1/2/4/8) in b, little endian
+typedef struct { uint64_t off; uint8_t b[8]; int n; } dm_cheat_patch;
