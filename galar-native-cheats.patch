+// The buttons held now, every source ORed, without taking the latched presses (the cheat engine's key conditions, cheat.c)
+uint64_t dm_input_held(void) {
+    uint64_t b = atomic_load(&g_btn) | atomic_load(&g_pad_btn);
+    if (now_ns() < atomic_load(&g_auto_until)) b |= atomic_load(&g_auto_btn);
