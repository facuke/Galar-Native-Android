diff --git a/dm/host/tests/t_cheat.c b/dm/host/tests/t_cheat.c
new file mode 100644
index 0000000..58837c6
--- /dev/null
+++ b/dm/host/tests/t_cheat.c
@@ -0,0 +1,75 @@
+// Unit test of the cheat VM and file parser (cheat_vm.c) against a fake guest memory. make -C dm/host/tests t_cheat   (needs no game profile)
+#include "../cheat_vm.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+
+static uint8_t mem[0x10000]; static uint64_t keys;
+#define MAINB 0x1000ull
+#define HEAPB 0x8000ull
+static int region(void *u, int t, uint64_t *b) { (void)u; if (t == 0) *b = MAINB; else if (t == 1) *b = HEAPB; else return 0; return 1; }
+static int rd(void *u, uint64_t a, void *buf, int n) { (void)u; if (a < MAINB || a + n > sizeof mem) return 1; memcpy(buf, mem + a, n); return 0; }
+static int wr(void *u, uint64_t a, const void *buf, int n) { (void)u; if (a < MAINB || a + n > sizeof mem) return 1; memcpy(mem + a, buf, n); return 0; }
+static uint64_t kk(void *u) { (void)u; return keys; }
+static const cheat_env env = { NULL, region, rd, wr, kk };
+static uint32_t r32(uint64_t a) { uint32_t v; memcpy(&v, mem + a, 4); return v; }
+static uint64_t r64(uint64_t a) { uint64_t v; memcpy(&v, mem + a, 8); return v; }
+static void run(const uint32_t *c, int n) { cheat_run(c, n, &env); }
+#define RUN(...) do { uint32_t c_[] = { __VA_ARGS__ }; run(c_, sizeof c_ / 4); } while (0)
+
+int main(void) {
+    // 0: stores to heap and main, widths, 64-bit (first word = high half), offset register
+    memset(mem, 0, sizeof mem);
+    RUN(0x04100000, 0x00000010, 0x0098967F);              assert(r32(HEAPB + 0x10) == 0x98967F);
+    RUN(0x01100000, 0x00000020, 0x000000AB);              assert(mem[HEAPB + 0x20] == 0xAB && mem[HEAPB + 0x21] == 0);
+    RUN(0x08000000, 0x00000030, 0x11223344, 0x55667788);  assert(r64(MAINB + 0x30) == 0x1122334455667788ull);
+    RUN(0x40010000, 0, 0x100, 0x04010000, 0x40, 0xCAFEBABE);   assert(r32(MAINB + 0x140) == 0xCAFEBABE);
+    RUN(0x04000000, 0x00FFFF00, 1);                        // outside the fake memory: dropped, no crash
+    // 1: conditional (1TMC: T=4 M=1 heap, C: 1 > 2 >= 3 < 4 <= 5 == 6 !=), else, nesting
+    memset(mem, 0, sizeof mem); *(uint32_t *)(mem + HEAPB) = 5;
+    RUN(0x14110000, 0, 5, 0x04000000, 0x10, 1, 0x20000000); assert(r32(MAINB + 0x10) == 0);      // 5 > 5 false
+    RUN(0x14120000, 0, 5, 0x04000000, 0x10, 1, 0x20000000); assert(r32(MAINB + 0x10) == 1);      // 5 >= 5
+    memset(mem + MAINB, 0, 0x100);
+    RUN(0x14160000, 0, 5, 0x04000000, 0x10, 1, 0x20000000); assert(r32(MAINB + 0x10) == 0);      // 5 != 5 false
+    *(uint32_t *)(mem + HEAPB) = 4;
+    RUN(0x14150000, 0, 5, 0x04000000, 0x10, 1, 0x21000000, 0x04000000, 0x14, 2, 0x20000000);
+    assert(r32(MAINB + 0x10) == 0 && r32(MAINB + 0x14) == 2);                                   // false: the else part only
+    *(uint32_t *)(mem + HEAPB) = 5; memset(mem + MAINB, 0, 0x100);
+    RUN(0x14150000, 0, 5, 0x04000000, 0x10, 1, 0x21000000, 0x04000000, 0x14, 2, 0x20000000);
+    assert(r32(MAINB + 0x10) == 1 && r32(MAINB + 0x14) == 0);                                   // true: the then part only
+    memset(mem + MAINB, 0, 0x100);
+    RUN(0x14150000, 0, 9, 0x14150000, 0, 5, 0x20000000, 0x04000000, 0x10, 1, 0x20000000, 0x04000000, 0x14, 3);
+    assert(r32(MAINB + 0x10) == 0 && r32(MAINB + 0x14) == 3);                                   // a false block skips its nested block's end
+    // 8: keys (8KKKKKKK: all of the mask held)
+    memset(mem, 0, sizeof mem); keys = 0x80;
+    RUN(0x80000280, 0x04000000, 0x10, 1, 0x20000000);      assert(r32(MAINB + 0x10) == 0);
+    keys = 0x2C0; RUN(0x80000280, 0x04000000, 0x10, 1, 0x20000000);   assert(r32(MAINB + 0x10) == 1);
+    // 3: loop (r0 = 4: the body runs 5 times); 6: store to [r3] and advance it
+    memset(mem, 0, sizeof mem);
+    RUN(0x40030000, 0, MAINB + 0x200, 0x30000000, 4, 0x64031000, 0, 0x77, 0x31000000);
+    for (int k = 0; k < 5; k++) assert(r32(MAINB + 0x200 + 4 * k) == 0x77);
+    assert(r32(MAINB + 0x200 + 20) == 0);
+    // 5 / 4 / A: a pointer chain: heap+0x40 holds a pointer to main+0x300; write 0xBEEF at pointer+0x10
+    memset(mem, 0, sizeof mem); *(uint64_t *)(mem + HEAPB + 0x40) = MAINB + 0x300;
+    RUN(0x58110000, 0x40, 0x40020000, 0, 0xBEEF, 0xA4210200, 0x10);
+    assert(r32(MAINB + 0x310) == 0xBEEF);
+    // 9: r4 = r2 + 1, stored through r1
+    RUN(0x40020000, 0, 10, 0x94042100, 1, 0x40010000, 0, MAINB + 0x400, 0xA4410000);
+    assert(r32(MAINB + 0x400) == 11);
+    // C0: compare a register with an immediate (C0TcSX##: T=4, c: ==, S=r5, X=4)
+    memset(mem, 0, sizeof mem);
+    RUN(0x40050000, 0, 7, 0xC0455400, 7, 0x04000000, 0x10, 1, 0x20000000);   assert(r32(MAINB + 0x10) == 1);
+    RUN(0x40050000, 0, 8, 0xC0455400, 7, 0x04000000, 0x14, 1, 0x20000000);   assert(r32(MAINB + 0x14) == 0);
+    // parse a file
+    FILE *f = fopen("/tmp/t_cheat_sample.txt", "w");
+    fputs("[100%捕捉 开]\n04000000 0077F6E8 529FFFE0\n\n[heap]\n04100000 45072DF4 0098967F\n\n{master}\n04000000 00000010 00000001\n\n[key]\n80000280\n04100000 00000008 00000009\n20000000\n\n[unsupported]\nC1000000 00000000\n", f); fclose(f);
+    cheat_t *c; int n = cheat_parse("/tmp/t_cheat_sample.txt", &c);
+    assert(n == 5);
+    assert(!strcmp(c[0].name, "100%捕捉 开") && c[0].flat && c[0].n == 3 && c[0].code[2] == 0x529FFFE0 && !c[0].why[0]);
+    assert(c[1].flat && c[2].master && c[2].flat);
+    assert(!c[3].flat && !c[3].why[0] && c[3].n == 5);
+    assert(c[4].why[0]);
+    cheat_free(c, n);
+    puts("t_cheat: ok"); return 0;
+}
diff --git a/dm/host/tests/t_cheat_glue.c b/dm/host/tests/t_cheat_glue.c
new file mode 100644
index 0000000..01a25a4
--- /dev/null
+++ b/dm/host/tests/t_cheat_glue.c
@@ -0,0 +1,34 @@
+// The cheat engine end to end against a fake main image and heap: a cheat file and toggles.txt in a temp folder, the static patches the loader would apply, and
+// the thread writing the heap. Needs the game profile (dm.h): make -C dm/host/tests GAME=<id> t_cheat_glue
+#include "dm.h"
+#include "../cheat.c"
+#include <assert.h>
+module_t g_mod[MAX_MOD]; int g_nmod;
+static uint8_t *heap; static size_t heap_sz = 0x10000; static uint64_t keys;
+int dm_guest_region(int type, uint64_t *base, size_t *size) { if (type == 1) { *base = (uint64_t)(uintptr_t)heap; *size = heap_sz; return 1; } return 0; }
+uint64_t dm_input_held(void) { return keys; }
+static void put(const char *path, const char *text) { FILE *f = fopen(path, "w"); assert(f); fputs(text, f); fclose(f); }
+int main(void) {
+    char dir[] = "/tmp/t_cheat_glueXXXXXX"; assert(mkdtemp(dir));
+    setenv("DM_CHEATS_DIR", dir, 1);
+    static uint8_t image[0x40000]; heap = calloc(1, heap_sz);
+    strcpy(g_mod[0].name, "main"); strcpy(g_mod[0].build_id, "a16802625e7826bf83b6f9708e475b91"); g_mod[0].base = image; g_mod[0].size = sizeof image;
+    g_mod[0].text_end = 0x10000; g_mod[0].key_page_off = 0x3C000; g_nmod = 1;
+    char p[256];
+    snprintf(p, sizeof p, "%s/A16802625E7826BF.txt", dir);   // the file named in capitals is found too
+    put(p, "[patch on]\n04000000 00000100 529FFFE0\n\n[heap money]\n04100000 00000040 0098967F\n\n[key]\n80000280\n04100000 00000050 00000001\n20000000\n\n[off]\n04100000 00000060 00000002\n");
+    dm_cheat_patch *v; assert(dm_cheat_static_patches("a16802625e7826bf83b6f9708e475b91", &v) == 0);           // nothing on: no patches
+    snprintf(p, sizeof p, "%s/toggles.txt", dir); put(p, "[patch on]\n[heap money]\n[key]\n");
+    g_nmod = 0;   // (the loader asks while main is not in g_mod yet)
+    int n = dm_cheat_static_patches("a16802625e7826bf83b6f9708e475b91", &v); g_nmod = 1; assert(n == 1 && v[0].off == 0x100 && v[0].n == 4 && !memcmp(v[0].b, "\xE0\xFF\x9F\x52", 4)); free(v);
+    dm_cheat_start();
+    for (int i = 0; i < 100 && !*(uint32_t *)(heap + 0x40); i++) usleep(10000);
+    assert(*(uint32_t *)(heap + 0x40) == 0x98967F);
+    assert(*(uint32_t *)(heap + 0x50) == 0 && *(uint32_t *)(heap + 0x60) == 0);   // key not held, cheat off
+    keys = 0x280; for (int i = 0; i < 100 && !*(uint32_t *)(heap + 0x50); i++) usleep(10000);
+    assert(*(uint32_t *)(heap + 0x50) == 1);
+    snprintf(p, sizeof p, "%s/toggles.txt", dir); put(p, "[off]\n");                 // toggled live
+    for (int i = 0; i < 150 && !*(uint32_t *)(heap + 0x60); i++) usleep(10000);
+    assert(*(uint32_t *)(heap + 0x60) == 2);
+    puts("t_cheat_glue: ok"); return 0;
+}
